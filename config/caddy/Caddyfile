{
	email admin@{$DOMAIN}
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# Guests (Tailscale CGNAT range, tag:guest enforced at the ACL layer too)
# get Jellyfin and Jellyseerr only. Everything else 403s even if they guess
# the hostname — network ACLs alone can't distinguish vhosts on :443.
(guest_block) {
	@not_guest not remote_ip {$TS_GUEST_RANGE}
	handle @not_guest {
		reverse_proxy {args[0]}
	}
	handle {
		respond "Forbidden" 403
	}
}

# LAN or Tailscale, no login. For clients that can't follow an auth redirect.
(internal_only) {
	@allowed remote_ip {$LAN_SUBNET} 100.64.0.0/10
	handle @allowed {
		reverse_proxy {args[0]}
	}
	handle {
		respond "Forbidden" 403
	}
}

# LAN or Tailscale AND authenticated via Authelia. Admin services only.
(protected) {
	@allowed remote_ip {$LAN_SUBNET} 100.64.0.0/10
	handle @allowed {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy {args[0]}
	}
	handle {
		respond "Forbidden" 403
	}
}

# --- Household facing: no Authelia, clients can't do the redirect ---

jellyfin.{$DOMAIN} {
	reverse_proxy jellyfin:8096
}

requests.{$DOMAIN} {
	reverse_proxy jellyseerr:5055
}

books.{$DOMAIN} {
	import internal_only audiobookshelf:80
}

ntfy.{$DOMAIN} {
	reverse_proxy 192.168.1.11:8080
}
calendar.{$DOMAIN} {
	import internal_only radicale:5232
}
# --- Authelia itself: must not sit behind forward_auth ---

auth.{$DOMAIN} {
	import internal_only authelia:9091
}

# --- Admin: login + TOTP required ---

{$DOMAIN} {
	handle /food* {
		redir https://food.{$DOMAIN} permanent
	}
	handle {
		import protected homepage:3000
	}
}
food.{$DOMAIN} {
	@allowed remote_ip {$LAN_SUBNET} 100.64.0.0/10
	handle @allowed {
		reverse_proxy wger-nginx-1:80 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond "Forbidden" 403
	}
}
